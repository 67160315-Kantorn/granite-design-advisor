# ไฟล์นี้อยู่ที่ root (ระดับเดียวกับ docker-compose.yml)
# Docker Compose จะอ่านไฟล์ .env ที่อยู่ระดับเดียวกันโดยอัตโนมัติ
# คัดลอกไฟล์นี้เป็น .env แล้วแก้รหัสผ่านให้เป็นของตัวเอง (ห้าม commit ไฟล์ .env ขึ้น git!)

MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=granite_db
MYSQL_USER=granite_user
MYSQL_PASSWORD=changeme_user_password
